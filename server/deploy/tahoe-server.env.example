# Copy to /etc/tahoe-server.env, chmod 600, owner root. NEVER commit the filled-in file.
HOST=127.0.0.1
PORT=3140
TAHOE_DB_PATH=/var/lib/tahoe-server/tahoe.db
TAHOE_DATA_DIR=/var/lib/tahoe-server
# openssl rand -hex 32   (losing it loses every account's data; keep a copy away from the server)
TAHOE_DATA_KEY=
# openssl rand -hex 9    (needed to create an account; leave empty to keep sign-ups closed)
TAHOE_INVITE_CODE=
# openssl rand -hex 32
TAHOE_SESSION_SECRET=
# existing admin settings, if you use them
TAHOE_ADMIN_USER=
TAHOE_ADMIN_PASSWORD=
